# In dev, requests to /api are proxied to the backend (see vite.config.ts) so
# VITE_API_URL can stay as-is. Only change it for a production build that
# talks to a backend on a different origin.
VITE_API_URL=/api
VITE_API_ORIGIN=http://localhost:4000

# --- Capacitor (iOS/Android) builds only ---
# There's no dev proxy inside a packaged native app, so both vars above
# must be full absolute URLs to the real deployed backend before running
# `npm run cap:sync` — e.g.:
#   VITE_API_URL=https://api.ptsaq.example.org
#   VITE_API_ORIGIN=https://api.ptsaq.example.org
# (Same values, no /api prefix — the backend's routes are already mounted
# at the root; /api is only the dev-proxy's own rewrite target.) Keep this
# in a separate .env.production or pass it inline when you run the build,
# so local web dev keeps using the proxy.
